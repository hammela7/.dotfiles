# Third-party shell plugins are opt-out. A host that creates ~/.zsh-noplugins
# loads none of antigen, oh-my-zsh, powerlevel10k or the zsh-users bundles, and
# falls back to a prompt that ships with zsh itself. Intended for hosts where
# this shell can reach everything and the only thing plugins buy is a nicer
# prompt — lorien is the hypervisor, and its aidan is in both sudo and docker.
# Everything else in this file still applies in that mode.
if [[ -e ~/.zsh-noplugins ]]; then
  _zsh_plugins=0
else
  _zsh_plugins=1
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
# Skipped without plugins, or a stale cache from a previous p10k install would
# paint an instant prompt for a theme that never loads.
if (( _zsh_plugins )) && [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Dedupe $PATH, keeping the first occurrence. Set before anything appends.
typeset -U path

if (( _zsh_plugins )); then
  # Homebrew ships antigen; everywhere else the Ansible dotfiles role drops a
  # copy in ~/antigen.zsh.
  if type brew &>/dev/null
  then
    source $(brew --prefix)/share/antigen/antigen.zsh
  else
    source ~/antigen.zsh
  fi
fi

## Auto complete
autoload -Uz compinit
compinit

## Auto Spell Correct
setopt correct

# History. These are zsh shell parameters, not environment variables, so they
# are deliberately not exported. append_history is on by default in zsh.
HISTFILE=~/.zsh_history
HISTSIZE=99999
SAVEHIST=99999
setopt extended_history         # record timestamps
setopt hist_expire_dups_first   # trim duplicates before unique entries
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt share_history

if (( _zsh_plugins )); then
  # Load the oh-my-zsh's library.
  antigen use oh-my-zsh

  # Plugins
  antigen bundle git
  antigen bundle colored-man-pages
  antigen bundle zsh-users/zsh-autosuggestions
  antigen bundle zsh-users/zsh-syntax-highlighting

  # Load the theme.
  antigen theme romkatv/powerlevel10k

  # OS-specific bundles, registered before `antigen apply`.
  case "$OSTYPE" in
    darwin*)
      antigen bundle thefuck
      antigen bundle iterm2
      ;;
  esac

  antigen apply

  # To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
  [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
else
  # zsh's own prompt framework — bundled with the shell, no third-party code.
  # adam2 is what lorien ran before it was brought onto the shared zshrc.
  # (It reads an intentionally-unset $_empty_zz to build its padding, which
  # errors only if something leaks `setopt nounset` into the shell.)
  autoload -Uz promptinit
  promptinit
  prompt adam2
fi

unset _zsh_plugins

# ── OS-specific ──────────────────────────────────────────────────────────────
# Paths and aliases, so this applies with or without plugins.
case "$OSTYPE" in
  darwin*)
    path=(/opt/homebrew/opt/gnu-sed/libexec/gnubin $path)
    [[ -d ~/.lmstudio/bin ]] && path+=(~/.lmstudio/bin)
    alias tailscale='/Applications/Tailscale.app/Contents/MacOS/Tailscale'
    ;;
  linux*)
    # sanoid/syncoid and friends install here, and Debian only puts
    # /usr/local/sbin on root's PATH.
    [[ -d /usr/local/sbin ]] && path=(/usr/local/sbin $path)
    ;;
esac

# pipx and friends; portable, so guarded by existence rather than by OS.
[[ -d ~/.local/bin ]] && path+=(~/.local/bin)

# Aliases
alias ll='ls -lah'
# Tail last 50 lines of docker logs
alias dtail='docker logs -tf --tail=50 '

# Shorthand, customise docker-compose.yaml location as needed
alias dcp='docker-compose -f ~/docker-compose.yaml '
# Which compose file is each running container from?
alias dcpls='docker ps -q | xargs -n 1 docker inspect | grep "com.docker.compose.project.config_files"'

alias venv='python3 -m venv .venv && source .venv/bin/activate && python3 -m pip install --upgrade pip &>/dev/null'

# ── Host-specific overrides ──────────────────────────────────────────────────
# Never tracked in git. This is the escape hatch for one-off machine-local
# tweaks: editing ~/.zshrc.local instead of this file is what stops the next
# Ansible run failing its `git pull` with "Local modifications exist".
# Antigen bundles cannot go here (antigen apply has already run) — put those
# in the OS block above.
#
# Deliberately an if-block, not `[[ -r ... ]] && source ...`: this is the last
# statement in the file, so a false `&&` would leave $? = 1 and p10k's status
# segment would render "1 err" on the first prompt of every shell that has no
# ~/.zshrc.local. An if with no else returns 0.
if [[ -r ~/.zshrc.local ]]; then
  source ~/.zshrc.local
fi
